{
  "productName": "Helix Greeter",
  "version": "0.1.0",
  "identifier": "org.helix.Greeter",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost asset://localhost",
      "assetProtocol": { "enable": true, "scope": ["/var/lib/helix-greeter/**"] }
    }
  },
  "bundle": { "active": false }
}
