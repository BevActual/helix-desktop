{
  "name": "helix-frontend",
  "private": true,
  "type": "module",
  "description": "Frontend workspace for the React apps (apps/*/web) and the shared component package (core/shared-ui/react). The shell (islands) and the greeter are in it too; the approval dialog stays hand-written.",
  "workspaces": [
    "core/shared-ui/react",
    "apps/helix-settings/web",
    "shell/helix-shell-tauri/web",
    "greeter/helix-greeter-tauri/web",
    "apps/helix-software/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint core/shared-ui/react apps/*/web/src shell/*/web/src greeter/*/web/src --max-warnings 0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
