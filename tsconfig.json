{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@helix/ui": ["./core/shared-ui/react/index.ts"] },
    "baseUrl": "."
  },
  "include": ["core/shared-ui/react", "apps/*/web/src"],
  "exclude": ["**/node_modules", "**/dist"]
}
