[Unit]
Description=Helix Shell exclusive-zone strut (top bar reserve)
PartOf=graphical-session.target
After=graphical-session.target niri.service
# Map before the painted bar so work area is stable when the bar starts.
Before=helix-shell-bar.service
Conflicts=helix-shell-dev.service
Conflicts=helix-shell-tauri.service
# Do NOT BindsTo the bar — this unit must survive restart-bar.

[Service]
Type=simple
ExecStart=@STRUT_BIN@
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
