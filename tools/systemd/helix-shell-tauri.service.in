[Unit]
Description=Helix Shell (Tauri)
PartOf=graphical-session.target
After=graphical-session.target helix-service.service
# Only one shell may hold the registered-desktop role, so starting either unit stops the other.
Conflicts=helix-shell-dev.service

[Service]
Type=simple
ExecStart=@SHELL_BIN@
Restart=on-failure
RestartSec=1
# This shell is the registered desktop and the Agent1 confirmer (the approval dialog).
Environment=HELIX_SHELL_CONFIRMER=1

[Install]
WantedBy=graphical-session.target
