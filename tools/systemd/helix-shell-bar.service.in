[Unit]
Description=Helix Shell bar (Top layer)
PartOf=graphical-session.target
After=graphical-session.target helix-service.service
Conflicts=helix-shell-dev.service
# Prefer the split pair over the legacy monolith unit.
Conflicts=helix-shell-tauri.service
# Keep Overlay panels alive while the bar is up (panels BindsTo the bar the other way).
Wants=helix-shell-panels.service
Upholds=helix-shell-panels.service

[Service]
Type=simple
ExecStart=@SHELL_BIN@
Restart=on-failure
RestartSec=1
Environment=HELIX_SHELL_ROLE=bar

[Install]
WantedBy=graphical-session.target
