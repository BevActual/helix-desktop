[Unit]
Description=Helix Shell panels (Overlay / Mobius dropdown)
PartOf=graphical-session.target
After=graphical-session.target helix-shell-bar.service helix-service.service
Conflicts=helix-shell-dev.service
Conflicts=helix-shell-tauri.service
# Do NOT BindsTo the bar: restart-bar would stop Overlay and destroy its layer surface,
# which (before the compositor skip) resized every tiled window. Bar Upholds=panels instead.

[Service]
Type=simple
ExecStart=@SHELL_BIN@
Restart=on-failure
RestartSec=1
Environment=HELIX_SHELL_ROLE=panels
# Confirmer / RegisterDesktop live with panels when split.
Environment=HELIX_SHELL_CONFIRMER=1

[Install]
WantedBy=graphical-session.target
