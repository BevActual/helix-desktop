#!/bin/sh
# What a niri key binding runs. Works under either shell: when the Tauri shell is the session shell it drives that
# (panels over org.helix.Shell1, volume and brightness directly); otherwise it hands the same request to the native shell.
#   helix-panel launcher | control-center | assistant | agents | notifications | quick-insert | settings | window-switcher
#   helix-panel lock | lid-close | dnd | night-light | media-toggle | media-next | media-previous | screenshot | screenshot-screen
#   helix-panel volume-up | volume-down | volume-mute | mic-mute | brightness-up | brightness-down
#   helix-panel desktop-capture [agent-desk|focused|all|OUTPUT]  (agent socket; respects HELIX_AGENT_IPC_DIR in nested tests)
set -u
cmd=${1:?usage: helix-panel <command>}
shift || true
arg=${1-}
# Split shell: bar owns org.helix.Shell; legacy monolith used helix-shell-tauri.service.
tauri() {
  systemctl --user is-active --quiet helix-shell-bar.service \
    || systemctl --user is-active --quiet helix-shell-tauri.service \
    || busctl --user status org.helix.Shell >/dev/null 2>&1
}
case "$cmd" in
  desktop-capture)
    ipc_dir=${HELIX_AGENT_IPC_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}}
    disp=${WAYLAND_DISPLAY:-wayland-0}
    sock=$ipc_dir/helix-$disp.sock
    if [ ! -S "$sock" ]; then
      echo "helix-panel: no agent socket at $sock (is helix-shell-bar running?)" >&2
      exit 1
    fi
    line=desktop-capture
    [ -n "$arg" ] && line="$line $arg"
    exec python3 - "$sock" "$line" <<'PY'
import socket, sys
sock, line = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX)
s.settimeout(60.0)
s.connect(sock)
s.sendall(("/\x1e" + line).encode())
s.shutdown(socket.SHUT_WR)
data = b""
while True:
    chunk = s.recv(4096)
    if not chunk:
        break
    data += chunk
sys.stdout.write(data.decode())
PY
    ;;
esac
if tauri; then
  case "$cmd" in
    launcher|control-center|assistant|agents|notifications|quick-insert)
      exec busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 TogglePanel s "$cmd" ;;
    dnd) exec busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 ToggleDoNotDisturb ;;
    night-light) exec busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 ToggleNightLight ;;
    media-toggle) exec playerctl play-pause ;;
    media-next) exec playerctl next ;;
    media-previous) exec playerctl previous ;;
    screenshot) exec niri msg action screenshot ;;
    screenshot-screen) exec niri msg action screenshot-screen ;;
    lock|lid-close)
      # swaylock speaks ext-session-lock-v1 (niri keeps the session locked even if the locker dies) and authenticates with PAM.
      # The colours are the shared tokens (core/shared-ui/style.css: accent, danger, ok) so the lock matches the login card.
      exec swaylock --daemonize --color 0e1028 --indicator-idle-visible --indicator-radius 70 --indicator-thickness 6 \
        --inside-color 1e1e22dd --inside-clear-color 1e1e22dd --inside-ver-color 1e1e22dd --inside-wrong-color 1e1e22dd \
        --ring-color ffffff24 --ring-clear-color ffffff24 --ring-ver-color 0a84ffff --ring-wrong-color ff453aff \
        --key-hl-color 0a84ffff --bs-hl-color ff453aff --line-color 00000000 --separator-color 00000000 \
        --text-color ffffffe6 --text-clear-color ffffffe6 --text-ver-color ffffffe6 --text-wrong-color ff453aff \
        --font Inter ;;
    settings) exec helix-settings ;;
    window-switcher) exec niri msg action focus-window-previous ;;
    volume-up) busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 AdjustVolume i 5 && exit 0; exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    volume-down) busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 AdjustVolume i -- -5 && exit 0; exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    volume-mute) busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 ToggleMute && exit 0; exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    mic-mute) exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    brightness-up) busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 AdjustBrightness i 5 && exit 0; exec brightnessctl --quiet set 5%+ ;;
    brightness-down) busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 AdjustBrightness i -- -5 && exit 0; exec brightnessctl --quiet set 5%- ;;
    bar-show) exec busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 BarShow ;;
    bar-hide) exec busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 BarHide ;;
    bar-toggle) exec busctl --user call org.helix.Shell /org/helix/Shell org.helix.Shell1 BarToggle ;;
    *) echo "helix-panel: unknown command $cmd" >&2; exit 2 ;;
  esac
fi
case "$cmd" in
  launcher|control-center) exec helix-shell msg panel-toggle "$cmd" ;;
  settings) exec helix-shell msg settings-toggle ;;
  lock) exec helix-shell msg session lock ;;
  lid-close) exec helix-shell msg session lid-close ;;
  window-switcher|volume-up|volume-down|volume-mute|mic-mute|brightness-up|brightness-down) exec helix-shell msg "$cmd" ;;
  notifications) exec helix-shell msg panel-toggle notifications ;;
  quick-insert) exec helix-shell msg panel-toggle quick-insert ;;
  dnd) exec helix-shell msg notification-dnd-toggle ;;
  night-light) exec helix-shell msg nightlight-toggle ;;
  media-toggle) exec helix-shell msg media toggle ;;
  media-next) exec helix-shell msg media next ;;
  media-previous) exec helix-shell msg media previous ;;
  screenshot) exec helix-shell msg screenshot-region ;;
  screenshot-screen) exec helix-shell msg screenshot-fullscreen ;;
  assistant|agents) exit 0 ;;
  *) echo "helix-panel: unknown command $cmd" >&2; exit 2 ;;
esac
