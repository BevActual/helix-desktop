# Build
build*
!**/build.rs
cmake-build-*/
compile_commands.json

# Python cache
__pycache__
tools/helix-agent/.venv/

# Editor / IDE
.vscode/
.idea/
.cache/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Nix
.envrc
.direnv/
result/
result
result-*

# Inference engine: source, build tree and install prefix (see docs/design/agent-and-inference.md)
/third_party/llama.cpp-*/
/third_party/llama.cpp-*.tar.gz
/third_party/.llama-build/
/third_party/llama-install/

# Shared UI is copied into each app's dist/ at build time
apps/*/dist/style.css
apps/*/dist/icons.js
shell/*/dist/style.css
shell/*/dist/icons.js
greeter/*/dist/style.css
greeter/*/dist/icons.js

!core/shared-ui/
!core/shared-ui/**

# Cargo workspace target (repo root)
/target/

# compositor (nested Cargo workspace)
/compositor/target/
/compositor/result
/compositor/result-*

# stray rustc outputs
rust_out
