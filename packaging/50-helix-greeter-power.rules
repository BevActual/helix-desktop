// The Helix login screen may restart and shut down the computer, and nothing else. It runs as the greetd account, on the active seat.
polkit.addRule(function(action, subject) {
    if (subject.user == "greetd" &&
        (action.id == "org.freedesktop.login1.power-off" ||
         action.id == "org.freedesktop.login1.reboot")) {
        return polkit.Result.YES;
    }
});
