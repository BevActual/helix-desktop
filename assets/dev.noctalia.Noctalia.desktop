[Desktop Entry]
Type=Application
Name=Helix Shell
Comment=niri-first Wayland desktop shell
Exec=noctalia --daemon
Icon=noctalia
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
Actions=Settings;
Keywords=desktop;shell;wayland;

[Desktop Action Settings]
Name=Open Settings
Exec=sh -c "noctalia msg settings-open || { noctalia --daemon && noctalia msg settings-open; }"
